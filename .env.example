# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Supabase (required) -----------------------------------------------------
# From your project's API settings. The VITE_ copies are what the browser reads;
# both sets must point at the same project.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# --- AI insights (optional) --------------------------------------------------
# Without a key the app runs fine; the AI insights screen reports that analysis
# is not configured. Server-side only: never prefix these with VITE_, or the key
# is bundled into the browser.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Demo sign-in cards (optional) -------------------------------------------
# On automatically in `bun run dev`. Only set this for a deployed demo: the demo
# password ships in the JS bundle.
# VITE_ENABLE_DEMO_LOGINS=true

# --- Database migrations (optional) ------------------------------------------
# Direct Postgres connection string, for `bunx drizzle-kit` against your own project.
# LOVABLE_DB_MIGRATION_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
